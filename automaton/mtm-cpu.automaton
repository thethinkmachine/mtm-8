  },
  "cam": {
    "x": 440,
    "y": 382,
    "z": 0.505
  },
  "meta": {
    "title": "8-tape accumulator CPU",
    "blurb": "A 19-opcode accumulator machine. Tapes: 1 ROM (the program), 2 ACC, 3 FLAG, 4 OPERAND, 5 RAM (32 words), 6 CALL walk-counter, 7 X, 8 return stack. Words are 5-bit and wrap mod 32.\n\nA program is  ^ flag # seed # then instructions, ending !  where flag is f or g and seed is the 5-bit initial ACC. Every instruction is  OP # operand #  including the trailing #.\n\nA S N O X  add/sub/and/or/xor a 5-bit i",
    "inputs": [
      {
        "w": "^f#00101#A#00110#!",
        "note": "ACC 5 + 6 = 11"
      },
      {
        "w": "^f#01100#N#01010#!",
        "note": "12 AND 10 = 8"
      },
      {
        "w": "^f#00111#T#00011#N#00000#L#00011#!",
        "note": "store 7 at RAM[3], clear, load it back"
      },
      {
        "w": "^f#00000#A#00001#C#00011#J#1#P#00000000#!",
        "note": "count up to 3 (a loop)"
      },
      {
        "w": "^f#00000#A#00100#C#01100#J#1#P#00000000#!",
        "note": "4 x 3 by repeated addition"
      },
      {
        "w": "^f#00000#A#00001#K#00000100#A#00001#M#2#A#01010#R#0#!",
        "note": "call a subroutine and return (= 12)"
      },
      {
        "w": "^f#00111#A#00000#U#0#E#0#N#00000#D#0#!",
        "note": "X-indexed store then load"
      },
      {
        "w": "^f#01001#!",
        "note": "halt immediately, ACC = 9"
      }
    ]
  }
}